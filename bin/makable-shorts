#!/usr/bin/env bash
# makable-shorts: the video pipeline's command line (python -m shorts), as the Claude Code plugin runs it. The plugin
# puts this folder on the Bash tool's PATH, so `makable-shorts drive RUN start ...` is a command like any other.
#
# The pipeline runs from the plugin's own folder, in Python environments of its own. This makes them with uv the first
# time, and again when pyproject.toml changes (after an update): `pipeline`, for every stage; `browser`, for
# browser-use, which pins its own packages, made when a command first needs a browser; and `kokoro`, for Kokoro's
# torch, made when a run Kokoro narrates is first made or spoken. They're in
# ~/.cache/makable-shorts/envs (SHORTS_ENVS), outside the plugin, which is replaced on each update; deleting them is safe.
#
# Nothing needs installing by hand: uv is yours if you have it, or else its own, downloaded the first time; ffmpeg is
# imageio-ffmpeg's, one of the pipeline's packages; and browser-use downloads Chromium if there's no Chrome.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/makable-shorts"
envs="${SHORTS_ENVS:-$cache/envs}"

# uv's own installer, into the cache only (UV_UNMANAGED_INSTALL: your shell's profile is left as it is). uvx comes
# with it, which browser-use downloads Chromium with.
uv_version=0.13.1
if ! command -v uv >/dev/null 2>&1; then
  if [ ! -x "$cache/uv/uv" ]; then
    command -v curl >/dev/null 2>&1 || {
      echo "makable-shorts needs curl, to download uv (or uv itself: https://docs.astral.sh/uv)" >&2
      exit 1
    }
    echo "makable-shorts: downloading uv $uv_version, which sets up its Python (the first time only)" >&2
    mkdir -p "$cache/uv"
    download="$(mktemp -d "$cache/.uv-download.XXXXXX")" # beside it, so moving it in is a rename
    trap 'rm -rf "$download"' EXIT
    # Under Rosetta (an Intel shell on an Apple Mac), the installer would pick Intel's uv, and it Intel's Python
    installer=sh
    if [ "$(/usr/sbin/sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then installer="arch -arm64 sh"; fi
    curl -LsSf "https://astral.sh/uv/$uv_version/install.sh" | UV_UNMANAGED_INSTALL="$download" UV_PRINT_QUIET=1 $installer >&2
    mv "$download/uvx" "$download/uv" "$cache/uv/" # uv last: once it is there, both are
    rm -rf "$download"
    trap - EXIT
  fi
  export PATH="$cache/uv:$PATH"
fi

# Makes the environment $1, with pyproject.toml's dependencies and its extras $2 (a comma-separated list), unless it's
# made for this pyproject.toml already. uv's own Python, so it's native (not an Intel one under Rosetta, say). One
# command at a time makes it (the others wait), and a lock whose command has gone is taken over.
environment() {
  local folder="$envs/$1" lock="$envs/.$1.lock" made extra holder
  local extras=()
  made="$(cksum <"$root/pyproject.toml") $2"
  [ "$(cat "$folder/.made-for" 2>/dev/null)" = "$made" ] && return
  mkdir -p "$envs"
  until mkdir "$lock" 2>/dev/null; do
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$lock"; else sleep 1; fi
  done
  echo $$ >"$lock/pid"
  held="$lock" # a global, for the trap: a failed install exits from in here
  trap 'rm -rf "$held"' EXIT
  if [ "$(cat "$folder/.made-for" 2>/dev/null)" != "$made" ]; then # another command may have made it meanwhile
    echo "makable-shorts: setting up its Python for the $1 (the first time, and after an update: a few minutes)" >&2
    for extra in ${2//,/ }; do extras+=(--extra "$extra"); done
    uv venv --quiet --allow-existing --managed-python --python 3.12 "$folder" >&2
    uv pip install --quiet --python "$folder/bin/python" -r "$root/pyproject.toml" "${extras[@]}" >&2
    echo "$made" >"$folder/.made-for"
  fi
  rm -rf "$lock"
  trap - EXIT
}

environment pipeline gemini,assemble,speech,heygen
if [ -z "${SHORTS_BROWSE_PYTHON:-}" ]; then # unless you've your own environment with browser-use
  case "${1:-}" in
  drive | signin) environment browser browse ;;
  esac
  export SHORTS_BROWSE_PYTHON="$envs/browser/bin/python"
fi

if [ -z "${SHORTS_KOKORO_PYTHON:-}" ]; then # unless you've your own environment with Kokoro
  case "${1:-}" in
  run | speak)
    # torch for the CPU (UV_TORCH_BACKEND): on Linux, pip's has CUDA's libraries too, gigabytes of them
    if grep -qs '"narrator": "kokoro"' "${2:-}/run.json"; then UV_TORCH_BACKEND=cpu environment kokoro kokoro; fi
    ;;
  esac
  if [ -x "$envs/kokoro/bin/python" ]; then export SHORTS_KOKORO_PYTHON="$envs/kokoro/bin/python"; fi
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export SHORTS_COMMAND=makable-shorts
exec "$envs/pipeline/bin/python" -m shorts "$@"
