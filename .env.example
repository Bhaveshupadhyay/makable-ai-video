# Copy to .env (git ignores it) and fill in what this machine uses. The environment wins over this file.
# One KEY=value a line; a # starts a comment only at the start of a line.

# browser-use's model (python -m shorts browse): provider:model, with its key below
# SHORTS_BROWSE_MODEL=google:gemini-3.6-flash
# SHORTS_BROWSE_FALLBACK=google:gemini-3-flash-preview
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# For another provider with OpenAI's API, such as OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# The Python of browser-use's own environment (it pins its own packages)
SHORTS_BROWSE_PYTHON=~/browse-env/bin/python

# Recording makable signed in as the demo user (see the README's Recording makable signed in)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MAKABLE_DEMO_EMAIL=
MAKABLE_DEMO_PASSWORD=

# The narration's voice API (services/voice on Modal; or https://api.elevenlabs.io with an ElevenLabs key)
SHORTS_SPEECH_URL=
SHORTS_SPEECH_KEY=
